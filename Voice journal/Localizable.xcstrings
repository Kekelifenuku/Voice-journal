    "No typing, no formatting. Press once and talk — your thoughts, exactly as they arrive." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Tippen, kein Formatieren. Einmal drücken und sprechen — deine Gedanken, genau so wie sie kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin escribir, sin formatear. Presiona una vez y habla — tus pensamientos, tal como llegan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de saisie, pas de mise en forme. Appuyez et parlez — vos pensées, telles qu'elles arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente digitazione, niente formattazione. Premi e parla — i tuoi pensieri, esattamente come arrivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイピングも書式設定も不要。ボタンを押して話すだけ — あなたの考えを、そのままに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이핑도, 서식도 필요 없습니다. 한 번 누르고 말하세요 — 생각을, 있는 그대로."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen typen, geen opmaak. Druk en praat — je gedachten, precies zoals ze komen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem digitar, sem formatar. Pressione uma vez e fale — seus pensamentos, exatamente como chegam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需打字，无需排版。按下按钮开始说 — 你的想法，原汁原味。"
          }
        }
      }
    },
