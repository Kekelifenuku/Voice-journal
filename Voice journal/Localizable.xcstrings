    "Record a few entries and your\ntrends will appear here." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm ein paar Einträge auf und deine\nTrends erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba algunas entradas y tus\ntendencias aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez quelques entrées et vos\ntendances apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra qualche voce e le tue\ntendenze appariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかのエントリを録音すると\nトレンドがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 개의 항목을 녹음하면\n트렌드가 여기에 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem een paar items op en je\ntrends verschijnen hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave algumas entradas e suas\ntendências aparecerão aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制几条日记，\n你的趋势将显示在这里。"
          }
        }
      }
    },
    "Record an entry, then tap the\nheart to keep it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen Eintrag auf, dann tippe\nauf das Herz, um ihn hier zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba una entrada, luego toca el\ncorazón para guardarla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une entrée, puis touchez\nle cœur pour la garder ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una voce, poi tocca il\ncuore per tenerla qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エントリを録音してからハートをタップすると\nここに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 녹음한 후 하트를 탭하면\n여기에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem een item op, tik dan op het\nhartje om het hier te bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave uma entrada, depois toque no\ncoração para guardá-la aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制一条日记，然后点击\n爱心将其保存到这里。"
          }
        }
      }
    },
    "Record your first entry" : {
      "extractionState" : "stale",
