    "A quiet summary of each entry, your moods over time, and the themes that keep returning." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ruhige Zusammenfassung jedes Eintrags, deine Stimmungen über die Zeit, und die Themen, die immer wiederkehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un resumen tranquilo de cada entrada, tus estados de ánimo con el tiempo, y los temas que siguen volviendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un résumé calme de chaque entrée, vos humeurs au fil du temps, et les thèmes qui reviennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un riepilogo tranquillo di ogni voce, i tuoi stati d'animo nel tempo, e i temi che continuano a tornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各エントリの穏やかな要約、時間の経過に伴う気分の変化、そして繰り返されるテーマ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목의 조용한 요약, 시간에 따른 기분 변화, 그리고 반복되는 주제들."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rustige samenvatting van elk item, je stemmingen over tijd, en de thema's die blijven terugkeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um resumo tranquilo de cada entrada, seus humores ao longo do tempo, e os temas que continuam retornando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条日记的简要摘要、随时间变化的心情、以及反复出现的主题。"
          }
        }
      }
    },
