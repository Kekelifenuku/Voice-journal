    "A calm mind is built one honest moment at a time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiger Geist entsteht, ein ehrlicher Moment nach dem anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mente en calma se construye un momento sincero a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esprit apaisé se construit un moment sincère à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mente serena si costruisce un momento sincero alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかな心は、正直なひとときを一つずつ積み重ねて育まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평온한 마음은 진솔한 순간을 하나씩 쌓아 만들어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kalme geest bouw je op, één eerlijk moment tegelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mente calma se constrói um momento sincero de cada vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平静的内心，是一个个真诚的瞬间累积而成的。"
          }
        }
      }
    },
