        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的声音变为可搜索的文字，完全在手机上完成。绝不上传。"
          }
        }
      }
    },
    "Your worth isn't measured by your output." : {
      "extractionState" : "manual",
      "localizations" : {
