    "Your voice becomes searchable text, right on your phone. Nothing is uploaded, ever." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Stimme wird zu durchsuchbarem Text, direkt auf deinem Handy. Nichts wird hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu voz se convierte en texto buscable, directamente en tu teléfono. Nada se sube, nunca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix devient du texte consultable, directement sur votre téléphone. Rien n'est téléchargé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua voce diventa testo ricercabile, direttamente sul tuo telefono. Nulla viene caricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの声が検索可能なテキストになります。すべてデバイス上で完結。何もアップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 목소리가 검색 가능한 텍스트가 됩니다. 모든 것이 휴대폰에서 처리됩니다. 업로드는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
