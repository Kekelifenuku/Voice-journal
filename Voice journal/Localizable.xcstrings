    "Begin before you feel ready — readiness often comes after." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne, bevor du dich bereit fühlst – Bereitschaft kommt oft danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza antes de sentirte listo; la preparación suele llegar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence avant de te sentir prêt — la préparation vient souvent après."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia prima di sentirti pronto: la prontezza spesso arriva dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたと感じる前に始めましょう。心構えは後からついてくるものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비됐다고 느끼기 전에 시작하세요. 준비는 대개 그 뒤에 따라옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin voordat je je klaar voelt — die zekerheid komt vaak daarna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece antes de se sentir pronto — a prontidão costuma vir depois."
          }
        },
        "zh-Hans" : {
