    "Give yourself credit for what no one else can see." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne dir das an, was sonst niemand sehen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconócete el mérito por lo que nadie más puede ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnais-toi le mérite de ce que personne d'autre ne voit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosciti il merito di ciò che nessun altro può vedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰にも見えないあなたの努力を、自分自身で認めてあげてください。"
