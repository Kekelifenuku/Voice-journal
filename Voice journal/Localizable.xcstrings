    "Courage is just fear that has said its piece and kept going." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mut ist nur die Angst, die ihren Teil gesagt hat und weitergemacht hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor no es más que el miedo que dijo lo suyo y siguió adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courage, c'est juste la peur qui a dit son mot et a continué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il coraggio è solo la paura che ha detto la sua ed è andata avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勇気とは、恐れが言い分を口にしたうえで、それでも前に進んだものにすぎません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용기란, 두려움이 할 말을 다 하고도 계속 나아간 것일 뿐입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moed is gewoon angst die haar zegje heeft gedaan en toch doorging."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coragem é apenas o medo que disse o que tinha a dizer e seguiu em frente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勇气，不过是恐惧说完了它想说的，然后依然前行。"
          }
        }
      }
    },
