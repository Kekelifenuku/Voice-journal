    "“I've been trying to slow down…”" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ich versuche, langsamer zu werden…”"
          }
        },
        "es" : {
