    "Everything stays on your device. No cloud, no account — no one else can read your journal." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf deinem Gerät. Keine Cloud, kein Konto — niemand sonst kann dein Tagebuch lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo permanece en tu dispositivo. Sin nube, sin cuenta — nadie más puede leer tu diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur votre appareil. Pas de cloud, pas de compte — personne d'autre ne peut lire votre journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta sul tuo dispositivo. Nessun cloud, nessun account — nessun altro può leggere il tuo diario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてがデバイス上に留まります。クラウドなし、アカウントなし — 誰もあなたの日記を読めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것이 기기에 남습니다. 클라우드도, 계정도 없습니다 — 아무도 당신의 일기를 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft op je apparaat. Geen cloud, geen account — niemand anders kan je dagboek lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo permanece no seu dispositivo. Sem nuvem, sem conta — ninguém mais pode ler seu diário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都保留在你的设备上。没有云端，没有账户 — 没有人能读到你的日记。"
          }
        }
      }
    },
