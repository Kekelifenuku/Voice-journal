    "Slowing down is sometimes the bravest thing you can do." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer zu werden ist manchmal das Mutigste, was du tun kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veces, ir más despacio es lo más valiente que puedes hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentir est parfois la chose la plus courageuse à faire."
          }
        },
