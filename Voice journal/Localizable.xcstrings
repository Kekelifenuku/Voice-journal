    "Progress is quiet more often than it's loud." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt ist öfter leise als laut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso es silencioso más a menudo de lo que es ruidoso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le progrès est plus souvent silencieux que bruyant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il progresso è silenzioso più spesso di quanto sia rumoroso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長は、派手であるよりも静かであることのほうが多いものです。"
