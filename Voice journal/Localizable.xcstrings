    "Not every day has to be productive to be meaningful." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht jeder Tag muss produktiv sein, um bedeutungsvoll zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No todos los días tienen que ser productivos para tener sentido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour n'a pas besoin d'être productif pour avoir du sens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ogni giorno deve essere produttivo per avere senso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味のある一日であるために、毎日が生産的である必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의미 있는 하루가 되기 위해 매일 생산적일 필요는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet elke dag hoeft productief te zijn om betekenisvol te zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem todo dia precisa ser produtivo para ter significado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并非每一天都要有产出，才算有意义。"
          }
        }
      }
